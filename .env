# Symfony env vars — committed defaults for local dev.
# Real values go in .env.local (gitignored) or platform env vars. See .env.example.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev-secret-not-for-production
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8080
###< symfony/framework-bundle ###

###> symfony/mailer ###
# Dev default: Mailpit from docker-compose (UI on http://localhost:8025)
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:app@127.0.0.1:5433/app?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

# Mail identities (dev defaults — production values in .env.local)
MAIL_FROM="Datenflow Website <noreply@datenflow.local>"
MAIL_TO_CONTACT=kontakt@datenflow.local
MAIL_TO_KARRIERE=jobs@datenflow.local
