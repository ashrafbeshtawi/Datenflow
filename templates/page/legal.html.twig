{% extends 'base.html.twig' %}

{% set page = t[section] %}

{% block body %}
<section class="section page-head">
    <div class="wrap wrap-narrow">
        <p class="kicker kicker-ruled kicker-left">{{ page.kicker }}</p>
        <h1>{{ page.title }}</h1>
        <p class="section-sub">{{ page.sub }}</p>
    </div>
</section>

<section class="section">
    <div class="wrap wrap-narrow legal">
        {% for sec in page.sections %}
            <h2 class="card-h">{{ sec.heading }}</h2>
            {% for line in sec.lines %}
                <p>{{ line }}</p>
            {% endfor %}
        {% endfor %}
    </div>
</section>
{% endblock %}
