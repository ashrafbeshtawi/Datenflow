{% extends 'base.html.twig' %}
{% from 'macros.html.twig' import accent, roman %}

{% block body %}
<section class="section page-head">
    <div class="wrap">
        <p class="kicker kicker-ruled kicker-left">{{ t.industries.kicker }}</p>
        <h1>{{ t.industries.title }}</h1>
        <p class="section-sub">{{ t.industries.sub }}</p>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="ledger">
            {% for item in t.industries.items %}
                <article class="ledger-item">
                    <span class="numeral">{{ roman(loop.index) }}</span>
                    <h2 class="card-h">{{ item.title }}</h2>
                    <p class="tagline">{{ item.tagline }}</p>
                    <p class="body-text">{{ item.body }}</p>
                    <ul class="dash-list">
                        {% for ex in item.examples %}<li>{{ ex }}</li>{% endfor %}
                    </ul>
                </article>
            {% endfor %}
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="split-head">
            <div>
                <p class="kicker kicker-ruled kicker-left">{{ t.services.kicker }}</p>
                <h2>{{ accent(t.services.title, t.services.title_em) }}</h2>
            </div>
            <p class="section-sub">{{ t.services.sub }}</p>
        </div>
        <div class="service-list">
            {% for item in t.services.items %}
                <article class="service">
                    <span class="numeral">{{ roman(loop.index) }}</span>
                    <div>
                        <h3>{{ item.title }}</h3>
                        <p class="body-text">{{ item.body }}</p>
                        <ul class="tag-list">
                            {% for ex in item.examples %}<li>{{ ex }}</li>{% endfor %}
                        </ul>
                    </div>
                </article>
            {% endfor %}
        </div>
    </div>
</section>

{% include 'partials/_cta_band.html.twig' %}
{% endblock %}
