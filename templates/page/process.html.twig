{% extends 'base.html.twig' %}

{% block body %}
<section class="section page-head">
    <div class="wrap">
        <p class="kicker kicker-ruled kicker-left">{{ t.process.kicker }}</p>
        <h1>{{ t.process.title }}</h1>
        <p class="section-sub">{{ t.process.sub }}</p>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <ol class="timeline">
            {% for step in t.process.steps %}
                <li>
                    <span class="timeline-num">{{ step.num }}</span>
                    <h2 class="card-h">{{ step.title }}</h2>
                    <p class="body-text">{{ step.body }}</p>
                    <p class="meta">{{ step.time }}</p>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>

{% include 'partials/_cta_band.html.twig' %}
{% endblock %}
