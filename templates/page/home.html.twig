{% extends 'base.html.twig' %}
{% from 'macros.html.twig' import icon %}

{% block body %}

<section class="hero">
    <div class="wrap hero-inner">
        <div class="hero-copy">
            <p class="kicker">{{ t.hero.eyebrow }}</p>
            <h1>{{ t.hero.title_pre }} <em>{{ t.hero.title_em }}</em></h1>
            <p class="lede">{{ t.hero.lede }}</p>
            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" href="{{ path('booking') }}">{{ t.hero.primary }}</a>
                <a class="btn btn-ghost btn-lg" href="{{ path('services') }}">{{ t.hero.secondary }}</a>
            </div>
            {% with {checks: t.hero.checks} %}{% include 'partials/_checks.html.twig' %}{% endwith %}
        </div>
        <div class="hero-art" aria-hidden="true">
            <svg viewBox="0 0 400 400" class="blob">
                <path fill="var(--sage)" opacity="0.45" d="M320 80c40 50 50 130 15 185s-115 85-185 65S30 240 40 165 115 35 190 35c55 0 95 5 130 45z"/>
                <path fill="var(--moss)" opacity="0.18" d="M300 130c30 40 35 105 5 150s-95 65-150 50S55 250 65 190 130 85 190 85c45 0 82 10 110 45z"/>
            </svg>
            <div class="hero-leaf">{{ icon('leaf') }}</div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <p class="kicker">{{ t.process.kicker }}</p>
        <h2>{{ t.process.title }}</h2>
        <p class="section-sub">{{ t.process.sub }}</p>

        <ol class="steps">
            {% for step in t.process.steps %}
                <li class="step">
                    <span class="step-num">{{ step.num }}</span>
                    <div>
                        <h3>{{ step.title }}</h3>
                        <p>{{ step.body }}</p>
                        <p class="step-time">{{ step.time }}</p>
                    </div>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>

<section class="section section-tinted">
    <div class="wrap">
        <p class="kicker">{{ t.pricing.kicker }}</p>
        <h2>{{ t.pricing.title }}</h2>
        <p class="section-sub">{{ t.pricing.sub }}</p>

        <h3>{{ t.pricing.ready_title }}</h3>
        <p class="section-sub">{{ t.pricing.ready_sub }}</p>
        <div class="card-grid cols-3">
            {% for opt in t.pricing.options %}
                <article class="card">
                    <h4 class="card-h">{{ opt.title }}</h4>
                    <p class="card-tagline">{{ opt.tagline }}</p>
                    <p>{{ opt.body }}</p>
                </article>
            {% endfor %}
        </div>

        <div class="card" style="margin-top: 1.5rem;">
            <h3 class="card-h">{{ t.pricing.custom_title }}</h3>
            <p>{{ t.pricing.custom_body }}</p>
        </div>
    </div>
</section>

{% include 'partials/_cta_band.html.twig' %}

{% endblock %}
