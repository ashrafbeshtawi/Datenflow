{% extends 'base.html.twig' %}
{% from 'macros.html.twig' import icon %}

{% block body %}

<section class="hero">
    <div class="wrap hero-inner">
        <div class="hero-copy">
            <p class="kicker">{{ t.hero.eyebrow }}</p>
            <h1>{{ t.hero.title_pre }} <em>{{ t.hero.title_em }}</em></h1>
            <p class="lede">{{ t.hero.lede }}</p>
            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" href="{{ path('booking') }}">{{ t.hero.primary }}</a>
                <a class="btn btn-ghost btn-lg" href="{{ path('services') }}">{{ t.hero.secondary }}</a>
            </div>
            {% with {checks: t.hero.checks} %}{% include 'partials/_checks.html.twig' %}{% endwith %}
        </div>
        <div class="hero-art" aria-hidden="true">
            <div class="hero-art-bg"></div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="card-grid cols-3">
            <article class="card">
                <span class="card-icon">{{ icon('custom') }}</span>
                <h2 class="card-h">{{ t.nav.services }}</h2>
                <p>{{ t.industries.sub }}</p>
                <p class="section-more"><a class="btn btn-ghost" href="{{ path('services') }}">{{ t.teasers.more }}</a></p>
            </article>
            <article class="card">
                <span class="card-icon">{{ icon('support') }}</span>
                <h2 class="card-h">{{ t.nav.process }}</h2>
                <p>{{ t.process.sub }}</p>
                <p class="section-more"><a class="btn btn-ghost" href="{{ path('process') }}">{{ t.teasers.more }}</a></p>
            </article>
            <article class="card">
                <span class="card-icon">{{ icon('check') }}</span>
                <h2 class="card-h">{{ t.nav.pricing }}</h2>
                <p>{{ t.pricing.sub }}</p>
                <p class="section-more"><a class="btn btn-ghost" href="{{ path('pricing') }}">{{ t.teasers.more }}</a></p>
            </article>
        </div>
    </div>
</section>

{% include 'partials/_cta_band.html.twig' %}

{% endblock %}
