<!DOCTYPE html>
<html lang="{{ lang|default('de') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% set route = app.request.attributes.get('_route') %}
    {% set seo = route and t.meta.pages[route] is defined ? t.meta.pages[route] : t.meta %}
    {% set noindex = sent|default(false) or route starts with 'admin' %}
    <title>{% block title %}{{ seo.title }}{% endblock %}</title>
    <meta name="description" content="{{ seo.description }}">
    {% if route %}{% set canonical = url(route, app.request.attributes.get('_route_params')) %}<link rel="canonical" href="{{ canonical }}">{% endif %}
    {# Only localized pages (route carries _locale) have a version in the other language. #}
    {% set page_route = app.request.attributes.get('_route_params')._locale is defined ? route : null %}
    {% if page_route %}
    <link rel="alternate" hreflang="de" href="{{ url(page_route, {_locale: 'de'}) }}">
    <link rel="alternate" hreflang="en" href="{{ url(page_route, {_locale: 'en'}) }}">
    <link rel="alternate" hreflang="x-default" href="{{ url(page_route, {_locale: 'de'}) }}">
    {% endif %}
    {% if noindex %}<meta name="robots" content="noindex">{% endif %}
    {% if not noindex %}
    {# Link previews (Open Graph is read by most chat apps and networks; X reads the twitter:card hint). #}
    {% set og_image = absolute_url(asset('img/og-image.png')) %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Datenflow">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ seo.description }}">
    {% if canonical is defined %}<meta property="og:url" content="{{ canonical }}">{% endif %}
    <meta property="og:locale" content="{{ lang == 'en' ? 'en_US' : 'de_DE' }}">
    <meta property="og:locale:alternate" content="{{ lang == 'en' ? 'de_DE' : 'en_US' }}">
    <meta property="og:image" content="{{ og_image }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Datenflow — {{ t.hero.eyebrow }}">
    <meta name="twitter:card" content="summary_large_image">
    {# Business details for search engines (schema.org), built from the contact copy. #}
    {% set postcode_city = t.contact.address[2]|split(' ', 2) %}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        'name': 'Datenflow',
        'description': t.meta.description,
        'url': url('home', {_locale: lang}),
        'logo': absolute_url(asset('favicon.png')),
        'image': og_image,
        'telephone': t.contact.phone|replace({' ': ''}),
        'email': t.contact.email,
        'address': {
            '@type': 'PostalAddress',
            'streetAddress': t.contact.address[1],
            'postalCode': postcode_city[0],
            'addressLocality': postcode_city[1],
            'addressCountry': 'DE',
        },
        'areaServed': 'DE',
        'inLanguage': [ 'de', 'en' ],
    }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}</script>
    {% endif %}
    <link rel="icon" href="{{ asset('logo.svg') }}" type="image/svg+xml">
    <link rel="icon" href="{{ asset('favicon.png') }}" type="image/png">
    <link rel="preload" href="{{ asset('fonts/cormorant-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('css/site.css') }}">
    {% block head %}{% endblock %}
</head>
<body>

<a class="skip-link" href="#main">{{ lang == 'en' ? 'Skip to content' : 'Zum Inhalt springen' }}</a>

<header class="site-header">
    <div class="wrap header-inner">
        <a class="brand" href="{{ path('home') }}" aria-label="Datenflow — {{ t.nav.home }}">
            <img class="brand-mark" src="{{ asset('logo.svg') }}" alt="">
            <span class="brand-name">Datenflow</span>
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
        <label for="nav-toggle" class="burger" aria-label="{{ lang == 'en' ? 'Menu' : 'Menü' }}">
            <span></span><span></span><span></span>
        </label>
        <nav class="site-nav" aria-label="{{ lang == 'en' ? 'Main navigation' : 'Hauptnavigation' }}">
            <span class="nav-links">
                <a href="{{ path('services') }}">{{ t.nav.services }}</a>
                <a href="{{ path('process') }}">{{ t.nav.process }}</a>
                <a href="{{ path('pricing') }}">{{ t.nav.pricing }}</a>
                <a href="{{ path('faq') }}">{{ t.nav.faq }}</a>
            </span>
            <span class="lang-switch">
                <a href="{{ path(page_route ?: 'home', {_locale: 'de'}) }}" hreflang="de" class="{{ lang == 'de' ? 'active' }}" lang="de">DE</a>
                <span aria-hidden="true">·</span>
                <a href="{{ path(page_route ?: 'home', {_locale: 'en'}) }}" hreflang="en" class="{{ lang == 'en' ? 'active' }}" lang="en">EN</a>
            </span>
            <a class="btn btn-primary nav-cta" href="{{ path('booking') }}">{{ t.nav.cta }}</a>
        </nav>
    </div>
</header>

{# Pages sit on the light parchment palette between the dark header and footer. #}
<main id="main" class="theme-light">
    {% block body %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="wrap footer-grid">
        <div>
            <p class="footer-brand">Datenflow</p>
            <p class="footer-blurb">{{ t.footer.blurb }}</p>
        </div>
        <div>
            <p class="footer-head">{{ t.nav.contact }}</p>
            <p><a href="tel:{{ t.contact.phone|replace({' ': ''}) }}">{{ t.contact.phone }}</a><br>
               <a href="mailto:{{ t.contact.email }}">{{ t.contact.email }}</a></p>
            <p>{{ t.contact.address|join(', ') }}</p>
        </div>
        <div>
            <p class="footer-head">{{ lang == 'en' ? 'Legal & more' : 'Rechtliches & mehr' }}</p>
            <p>
            {% for link in t.footer.links %}
                <a href="{{ path(link.route) }}">{{ link.label }}</a>{% if not loop.last %}<br>{% endif %}
            {% endfor %}
            </p>
        </div>
    </div>
    <div class="wrap footer-copy">{{ t.footer.copy }}</div>
</footer>

</body>
</html>
