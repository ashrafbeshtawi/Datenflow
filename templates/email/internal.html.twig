{#- Staff mails: a heading, the submitted fields as a table (rows are
    [label, value] pairs), the free-text message. -#}
{% extends 'email/layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 20px;font-family:Georgia,'Palatino Linotype',serif;font-size:20px;font-weight:normal;color:#1E1913;">{{ heading }}</h1>
    {% if rows %}
        <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;margin:0 0 20px;">
            {% for row in rows %}
                {% set value = row[1] %}
                <tr>
                    <td style="padding:6px 12px 6px 0;border-bottom:1px solid #EFE7D9;color:#7D7262;white-space:nowrap;vertical-align:top;">{{ row[0] }}</td>
                    <td style="padding:6px 0;border-bottom:1px solid #EFE7D9;color:#1E1913;">
                        {%- if value starts with 'https://' -%}
                            <a href="{{ value }}" style="color:#B08A42;">{{ value }}</a>
                        {%- else -%}
                            {{ value }}
                        {%- endif -%}
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}
    {% if message %}
        <p style="margin:0 0 6px;color:#7D7262;">Nachricht</p>
        <p style="margin:0;padding:12px 16px;background:#F8F4EC;border-left:3px solid #B08A42;">{{ message|nl2br }}</p>
    {% endif %}
{% endblock %}
