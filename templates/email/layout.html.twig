{#- Shared shell for all outgoing mails: table layout + inline styles, since
    mail clients ignore <style> blocks and external CSS. Light palette from
    site.css (ink #1E1913, gold #B08A42) reads well in every client. -#}
<!DOCTYPE html>
<html lang="{{ lang|default('de') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#F4EFE6;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F4EFE6;">
    <tr>
        <td align="center" style="padding:32px 16px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#FFFFFF;border:1px solid #E2D8C6;border-radius:6px;">
                <tr>
                    <td style="padding:24px 32px;border-bottom:2px solid #B08A42;font-family:Georgia,'Palatino Linotype',serif;font-size:22px;color:#1E1913;letter-spacing:0.5px;">
                        Datenflow
                    </td>
                </tr>
                <tr>
                    <td style="padding:28px 32px;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;line-height:1.6;color:#3E362B;">
                        {% block content %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 32px;border-top:1px solid #E2D8C6;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-size:12px;color:#7D7262;">
                        Datenflow · Berlin · <a href="https://datenflow.de" style="color:#7D7262;">datenflow.de</a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
