{% extends 'base.html.twig' %}

{% block title %}Admin — Datenflow{% endblock %}

{% block body %}
<section class="section">
    <div class="wrap">
        <p class="kicker">Intern</p>
        <h1>Admin.</h1>
        {% if notice %}
            <p class="form-success" role="status">{{ notice }}</p>
        {% endif %}

        <div class="admin-section">
            <h2>Anfragen &amp; Buchungen</h2>
            <div class="slot-scroll">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Eingang</th><th>Typ</th><th>Name</th><th>E-Mail</th><th>Termin</th><th>Status</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for inquiry in inquiries %}
                            <tr>
                                <td>{{ inquiry.createdAt|date('d.m.Y H:i') }}</td>
                                <td>{{ inquiry.type }}</td>
                                <td>{{ inquiry.name }}</td>
                                <td><a href="mailto:{{ inquiry.email }}">{{ inquiry.email }}</a></td>
                                <td>
                                    {% if inquiry.startsAt %}
                                        {{ inquiry.startsAt|date('d.m.Y H:i') }}
                                        {{ inquiry.callType ? '(' ~ (inquiry.callType == 'video' ? 'Video' : 'Telefon') ~ ')' }}
                                    {% endif %}
                                </td>
                                <td><span class="status-{{ inquiry.status }}">{{ inquiry.status == 'confirmed' ? 'aktiv' : 'storniert' }}</span></td>
                                <td>
                                    <a class="btn btn-ghost btn-sm" href="{{ path('admin_inquiry', {id: inquiry.id}) }}">Bearbeiten</a>
                                    {% if inquiry.status == 'confirmed' and inquiry.startsAt %}
                                        <form method="post" action="{{ path('admin_cancel', {id: inquiry.id}) }}" style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                            <button class="btn btn-danger btn-sm" type="submit">Stornieren</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7">Noch keine Anfragen.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="admin-section">
            <h2>Verfügbarkeit</h2>
            <table class="admin-table">
                <thead><tr><th>Wochentag</th><th>Von</th><th>Bis</th><th></th></tr></thead>
                <tbody>
                    {% for rule in rules %}
                        <tr>
                            <td>{{ t.booking.slot.weekdays[rule.weekday - 1] }}</td>
                            <td>{{ rule.startTime|date('H:i') }}</td>
                            <td>{{ rule.endTime|date('H:i') }}</td>
                            <td>
                                <form method="post" action="{{ path('admin_availability_delete', {id: rule.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                    <button class="btn btn-danger btn-sm" type="submit">Löschen</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">Keine Regeln, es sind keine Termine buchbar.</td></tr>
                    {% endfor %}
                </tbody>
            </table>

            <h3>Regel hinzufügen</h3>
            <form class="admin-inline-form" method="post" action="{{ path('admin_availability_add') }}">
                <label>Wochentag
                    <select name="weekday">
                        {% for name in t.booking.slot.weekdays %}
                            <option value="{{ loop.index }}">{{ name }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>Von <input type="time" name="start_time" step="1800" value="09:00" required></label>
                <label>Bis <input type="time" name="end_time" step="1800" value="17:00" required></label>
                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                <button class="btn btn-primary btn-sm" type="submit">Hinzufügen</button>
            </form>

            <h3>Einzelnen Slot blockieren</h3>
            <form class="admin-inline-form" method="post" action="{{ path('admin_block') }}">
                <label>Datum <input type="date" name="date" required></label>
                <label>Uhrzeit <input type="time" name="time" step="1800" required></label>
                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                <button class="btn btn-primary btn-sm" type="submit">Blockieren</button>
            </form>
            <p class="field-hint">Blockierte Slots erscheinen als „Blockiert“ in der Liste oben und lassen sich dort wieder stornieren.</p>
        </div>

        <div class="admin-section">
            <h2>Einstellungen</h2>
            <form class="admin-inline-form" method="post" action="{{ path('admin_settings') }}">
                <label>Google-Meet-Link <input type="url" name="meet_link" size="40" value="{{ meet_link }}" required></label>
                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                <button class="btn btn-primary btn-sm" type="submit">Speichern</button>
            </form>
        </div>
    </div>
</section>
{% endblock %}
