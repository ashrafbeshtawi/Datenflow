{% extends 'base.html.twig' %}

{% block title %}Login — Datenflow{% endblock %}

{% block body %}
<section class="section">
    <div class="wrap wrap-narrow">
        <p class="kicker">Intern</p>
        <h1>Anmelden.</h1>
        {% if error %}
            <p class="form-error-summary" role="alert">Login fehlgeschlagen.</p>
        {% endif %}

        <form class="form-card" method="post" action="{{ path('admin_login') }}">
            <label>Benutzername
                <input type="text" name="username" required autocomplete="username" autofocus>
            </label>
            <label>Passwort
                <input type="password" name="password" required autocomplete="current-password">
            </label>
            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
            <button class="btn btn-primary" type="submit">Anmelden</button>
        </form>
    </div>
</section>
{% endblock %}
