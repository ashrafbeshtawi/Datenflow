{% extends 'base.html.twig' %}

{% block title %}Anfrage bearbeiten — Datenflow{% endblock %}

{% block body %}
<section class="section">
    <div class="wrap wrap-narrow">
        <p class="kicker">Intern</p>
        <h1>Anfrage #{{ inquiry.id }} bearbeiten.</h1>
        <p class="section-sub">
            {{ inquiry.type }} · eingegangen {{ inquiry.createdAt|date('d.m.Y H:i') }}
            {% if inquiry.startsAt %} · Termin {{ inquiry.startsAt|date('d.m.Y H:i') }}{% endif %}
            · {{ inquiry.status == 'confirmed' ? 'aktiv' : 'storniert' }}
        </p>

        <form class="form-card" method="post" action="{{ path('admin_inquiry', {id: inquiry.id}) }}">
            <label>Name
                <input type="text" name="name" required maxlength="200" value="{{ inquiry.name }}">
            </label>
            <label>E-Mail
                <input type="email" name="email" required maxlength="320" value="{{ inquiry.email }}">
            </label>
            <label>Nachricht
                <textarea name="message" rows="6" maxlength="5000">{{ inquiry.message }}</textarea>
            </label>
            {% if inquiry.payload %}
                <p class="field-hint">
                    Weitere Angaben:
                    {% for key, value in inquiry.payload %}{{ key }}: {{ value }}{% if not loop.last %} · {% endif %}{% endfor %}
                </p>
            {% endif %}
            <p class="field-hint">Termin verschieben = hier stornieren, Kunde bucht neu.</p>
            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
            <button class="btn btn-primary" type="submit">Speichern</button>
            <a class="btn btn-ghost" href="{{ path('admin') }}">Zurück</a>
        </form>
    </div>
</section>
{% endblock %}
