# Copy me to .env (gitignored) — `docker compose up` does this automatically
# on first boot. The dev defaults below work with the docker-compose stack
# out of the box.
# ---------------------------------------------------------------------------

APP_ENV=dev
APP_SECRET=dev-secret-not-for-production
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8080

# Database (docker-compose Postgres, host port 5433)
DATABASE_URL="postgresql://app:app@127.0.0.1:5433/app?serverVersion=18&charset=utf8"

# Mail — dev default: Mailpit from docker-compose (UI on http://localhost:8025)
MAILER_DSN=smtp://localhost:1025

# Identities / inboxes
MAIL_FROM="Datenflow Website <noreply@datenflow.local>"
MAIL_TO_CONTACT=kontakt@datenflow.local
MAIL_TO_KARRIERE=jobs@datenflow.local

# ---------------------------------------------------------------------------
# Production (Hostinger Email, datenflow.de) — set these on the server.
# NEVER commit the real values.
#
# APP_ENV=prod
# APP_SECRET=<generate: php -r "echo bin2hex(random_bytes(16));">
# DATABASE_URL="postgresql://<user>:<pass>@<host>:5432/<db>?serverVersion=18&charset=utf8"
#
# Sender must match the authenticated user on Hostinger to avoid 550 5.7.1.
# MAILER_DSN=smtps://kontakt%40datenflow.de:<mailbox password>@smtp.hostinger.com:465
# MAIL_FROM="Datenflow <kontakt@datenflow.de>"
#
# Inboxes (aliases on datenflow.de — all routed by Hostinger):
# MAIL_TO_CONTACT=kontakt@datenflow.de
# MAIL_TO_KARRIERE=jobs@datenflow.de
