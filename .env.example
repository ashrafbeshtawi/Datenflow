# SMTP transport — used by lib/mailer.js
# ---------------------------------------------------------------------------
# Dev defaults (running via docker-compose with Mailpit):
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Identities
MAIL_FROM="Datenflow Website <noreply@datenflow.local>"

# Inboxes (different recipients per form)
MAIL_TO_CONTACT=kontakt@datenflow.local
MAIL_TO_KARRIERE=jobs@datenflow.local

# ---------------------------------------------------------------------------
# Production (Hostinger Email, datenflow.de) — set these on the server.
# NEVER commit the real SMTP_PASS. Use platform secrets or an .env file
# with `chmod 600` that is gitignored.
#
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=kontakt@datenflow.de
# SMTP_PASS=<mailbox password>
#
# Sender must match the authenticated user on Hostinger to avoid 550 5.7.1
# MAIL_FROM="Datenflow <kontakt@datenflow.de>"
#
# Inboxes (aliases on datenflow.de — all routed by Hostinger):
# MAIL_TO_CONTACT=kontakt@datenflow.de
# MAIL_TO_KARRIERE=jobs@datenflow.de
