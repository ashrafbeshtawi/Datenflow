# Production configuration template — copy relevant lines to .env.local on the
# server (chmod 600, gitignored). NEVER commit real credentials.

APP_ENV=prod
APP_SECRET=<generate: php -r "echo bin2hex(random_bytes(16));">

# ---------------------------------------------------------------------------
# Database
DATABASE_URL="postgresql://<user>:<pass>@<host>:5432/<db>?serverVersion=18&charset=utf8"

# ---------------------------------------------------------------------------
# Mail — production (Hostinger Email, datenflow.de)
# Sender must match the authenticated user on Hostinger to avoid 550 5.7.1.
MAILER_DSN=smtps://kontakt%40datenflow.de:<mailbox password>@smtp.hostinger.com:465

MAIL_FROM="Datenflow <kontakt@datenflow.de>"

# Inboxes (aliases on datenflow.de — all routed by Hostinger)
MAIL_TO_CONTACT=kontakt@datenflow.de
MAIL_TO_KARRIERE=jobs@datenflow.de
